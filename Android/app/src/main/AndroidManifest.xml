<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Wi-Fi multicast filtering normally drops the mDNS replies AdbDiscovery needs to find
      Android's wireless-debugging services (_adb-tls-pairing._tcp / _adb-tls-connect._tcp).
      Held briefly during each discovery; see AdbDiscovery.discover.
    -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      The wireless-debugging "Pair device with a pairing code" dialog stops advertising its
      mDNS service the moment it backgrounds. To pair without leaving the dialog, Glashutte
      posts a notification with a RemoteInput field — the user types the code in the
      notification shade *over* the dialog. Needs POST_NOTIFICATIONS on Android 13+.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Granted once at first launch so the OS doesn't re-prompt every time a launched app
      (e.g. a video-call client running on the workspace) tries to record audio.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Android withholds USB access to a device that exposes a video-class interface until the
      app holds CAMERA. The glasses' Carina VIO cameras do, so 6DOF head tracking may need it.
      Requested only when the glasses USB device actually has such an interface (see
      GlassesUsb / MainActivity). `required=false` keeps the app installable on camera-less devices.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      WorkspaceService is a foreground service tied to the glasses USB session — it lets
      Glashutte keep the workspace + launched apps alive while the phone screen is off, and
      its onDestroy is the cleanup anchor that force-stops launched apps when the glasses
      disconnect. `connectedDevice` is the Android 14+ FGS type for "driven by an external
      device connection".
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!--
      Glashutte lists the installed apps the user can launch onto a virtual screen, so it needs
      to see other packages' launcher activities (Android 11+ package visibility).
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GlashutteApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Glashutte">

        <!-- Phone-side control panel: pick an app, see glasses status. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
              Connecting the VITURE glasses launches Glashutte and, by virtue of receiving this
              intent, grants it USB access to the glasses — so head tracking can read the IMU
              without a separate, easily-missed permission prompt.
            -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
                android:resource="@xml/device_filter" />
        </activity>

        <!-- Head-tracking diagnostics + log export (own launcher icon). -->
        <activity
            android:name=".DiagnosticsActivity"
            android:exported="true"
            android:label="Glashutte Diagnostics"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          Receives the PrivilegedServer's Binder back from the shell-uid process. The server
          (started via app_process under the embedded-ADB bootstrap, see docs/PRIVILEGE.md)
          calls this provider, passing its Binder in a Bundle; the provider hands it to
          PrivilegedService. exported=true so the shell-uid process can reach it; the call()
          handler restricts callers to the shell or the app's own uid.
        -->
        <provider
            android:name=".privileged.BinderReceiverProvider"
            android:authorities="io.github.dmulder.glashutte.privileged"
            android:enabled="true"
            android:exported="true" />

        <!--
          Catches the RemoteInput pairing code typed into PairingNotifier's notification.
          Not exported — only Glashutte's own notification can deliver into it.
        -->
        <receiver
            android:name=".privileged.PairingInputReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="io.github.dmulder.glashutte.privileged.SUBMIT_PAIRING_CODE" />
            </intent-filter>
        </receiver>

        <!--
          Workspace lifecycle anchor. Started by MainActivity when the glasses display
          comes up; stopped when it goes away (or when the activity is destroyed). Its
          onDestroy force-stops every app Glashutte launched into the workspace, so a
          launched app never outlives the glasses session.
        -->
        <service
            android:name=".WorkspaceService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
          Accessibility service — subscribes to focus events so we can open the phone
          keyboard whenever the user taps into a text field on one of the workspace's
          virtual displays. Requires a one-time opt-in in Settings > Accessibility.
        -->
        <service
            android:name=".GlashutteAccessibilityService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
